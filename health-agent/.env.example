# Slack (리브에서 쓰던 앱을 재사용하거나 새 앱을 만들어 발급)
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...   # Socket Mode용 App-Level Token (connections:write)
SLACK_USER_ID=U0123ABCDEF  # 식사 질문을 받을 사용자의 멤버 ID

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-opus-5

# 식약처 식품영양성분 DB (선택 — 없으면 LLM 추정만 사용)
# 공공데이터포털(data.go.kr)에서 "식품의약품안전처_식품영양성분DB" 활용신청 후 발급
# NUTRITION_API_KEY=...

# 데이터 (기본값: health-agent/meals.db)
# DB_PATH=/path/to/meals.db
